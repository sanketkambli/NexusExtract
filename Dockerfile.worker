# Stage 1: Build .NET 10 Solution
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files first for optimal layer caching
COPY ["src/NexusExtract.Domain/NexusExtract.Domain.csproj", "NexusExtract.Domain/"]
COPY ["src/NexusExtract.Adapters/NexusExtract.Adapters.csproj", "NexusExtract.Adapters/"]
COPY ["src/NexusExtract.Application/NexusExtract.Application.csproj", "NexusExtract.Application/"]
COPY ["src/NexusExtract.Infrastructure/NexusExtract.Infrastructure.csproj", "NexusExtract.Infrastructure/"]
COPY ["src/NexusExtract.Worker/NexusExtract.Worker.csproj", "NexusExtract.Worker/"]
COPY ["Directory.Build.props", "./"]

RUN dotnet restore "NexusExtract.Worker/NexusExtract.Worker.csproj"

# Copy source code and build Release
COPY src/ ./
WORKDIR "/src/NexusExtract.Worker"
RUN dotnet build "NexusExtract.Worker.csproj" -c Release -o /app/build

# Stage 2: Publish
FROM build AS publish
RUN dotnet publish "NexusExtract.Worker.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Stage 3: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

# Non-root secure user
USER $APP_UID

ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV ASPNETCORE_ENVIRONMENT=Production

COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "NexusExtract.Worker.dll"]
